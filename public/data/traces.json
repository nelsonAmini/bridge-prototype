    "key": false
   },
   {
    "id": "P5",
    "type": "passage",
    "label": "P5",
    "x": 974,
    "y": 190,
    "w": 20,
    "h": null,
    "source": "S1",
    "quote": "A phased, parish-by-parish migration would keep the registry open throughout.",
    "page": "p. 14",
    "key": true
   },
   {
    "id": "P6",
    "type": "passage",
    "label": "P6",
