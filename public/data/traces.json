    "w": 20,
    "h": null,
    "source": "S1",
    "quote": "The registry currently holds 128,400 parcel records.",
    "page": "p. 6",
    "key": false
   },
   {
    "id": "P4",
    "type": "passage",
    "label": "P4",
    "x": 950,
    "y": 190,
    "w": 20,
    "h": null,
    "source": "S1",
    "quote": "Two of the three database servers are past vendor support.",
