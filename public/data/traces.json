    "key": true
   },
   {
    "id": "P11",
    "type": "passage",
    "label": "P11",
    "x": 135,
    "y": 151,
    "w": 20,
    "h": null,
    "source": "S5",
    "quote": "Cabinet agreed in principle to replace the land registry system.",
