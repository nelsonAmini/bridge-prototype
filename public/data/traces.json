    "key": true
   },
   {
    "id": "P12",
    "type": "passage",
    "label": "P12",
    "x": 160,
    "y": 145,
    "w": 20,
    "h": null,
    "source": "S5",
    "quote": "Any replacement must keep title transactions running during the change.",
